# The only public entry point. Cloudflare (SSL mode "Full (strict)") -> nginx :443 -> django / web on the
# internal network. The nginx image runs envsubst on *.template at start, filling ${API_DOMAIN} / ${APP_DOMAIN}.
# certs/origin.pem + certs/origin.key: Cloudflare Origin Certificate covering both domains (not in git).

ssl_certificate     /etc/nginx/certs/origin.pem;
ssl_certificate_key /etc/nginx/certs/origin.key;
ssl_protocols       TLSv1.2 TLSv1.3;

client_max_body_size 20m;  # photos and documents go straight to R2; this only bounds what reaches Django
server_tokens off;

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_read_timeout 65s;  # just past gunicorn's --timeout 60

server {
    listen 80 default_server;
    return 301 https://$host$request_uri;
}

# Unknown Host headers (scanners hitting the bare IP) get dropped
server {
    listen 443 ssl default_server;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    # Collected by the django service on start (shared `static` volume): admin CSS/JS
    location /static/ {
        alias /static/;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://django:8000;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    location / {
        proxy_pass http://web:3000;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $http_connection;
    }
}
