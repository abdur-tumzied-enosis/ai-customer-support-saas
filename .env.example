# Copy this file to `.env` in the repo root for docker-compose

# Django
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=["*"]

# Postgres (matches docker-compose service names)
POSTGRES_DB=auto_magic_pro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
FB_VERIFY_TOKEN=verify-token
# Public https base URL Meta calls (ngrok in dev, domain in prod); shown as the webhook callback URL
PUBLIC_BASE_URL=

# Google / Gemini
GOOGLE_API_KEY=
# Thinking for customer replies (Gemini 3+): low / medium / high; empty = model default
LLM_THINKING_LEVEL=

# Seconds between a reply and the contact-memory LLM extraction that covers it (one run per burst)
MEMORY_UPDATE_DELAY_SECONDS=300

# Embedding / reranker model servers; docker-compose sets them. Empty = load the models in each process
# EMBEDDINGS_URL=http://embeddings
# RERANKER_URL=http://reranker

# Parallel customer replies (celery-replies processes, ~200MB each with the model servers)
REPLY_WORKER_CONCURRENCY=16

# Interactive test (optional)
INTERACTIVE_QUESTION=What are your hours?
INTERACTIVE_BUSINESS_NAME=Demo Biz
INTERACTIVE_BUSINESS_SLUG=demo-biz


# Website widget rate limits (DRF rate strings); defaults in core/settings.py
# WIDGET_SESSION_RATE=60/hour
# WIDGET_VISITOR_MESSAGE_RATE=10/min
# WIDGET_MESSAGE_RATE=2000/day
