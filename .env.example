# Copy this file to `.env` in the repo root for docker-compose

# Django
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=["*"]
# Local dev only: gunicorn restarts on code changes (production leaves this unset)
GUNICORN_CMD_ARGS=--reload

# Production (DEBUG=false refuses to start without a real SECRET_KEY; enables HTTPS redirect, HSTS, secure cookies)
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_COOKIE_DOMAIN=.example.com
# ADMIN_URL=some-unguessable-path/
# NUM_PROXIES=1
# AUTH_THROTTLE_RATE=10/min
# Frontend origin: widget "Powered by" + fallback privacy link
# SITE_URL=https://app.example.com
# PRODUCT_NAME=TumarAgent

# Email (verification codes, password reset links → SITE_URL/reset-password): Gmail SMTP + an app password
# (Google account → Security → 2-Step Verification → App passwords). No password → emails print to the logs.
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# DEFAULT_FROM_EMAIL=TumarAgent <you@gmail.com>
# Public PNG of app_logo/lockup_black.png for the email header (SVG doesn't render in mail clients). Empty → text wordmark.
# EMAIL_LOGO_URL=https://assets.tumaragent.com/lockup_black.png

# Postgres (matches docker-compose service names)
POSTGRES_DB=auto_magic_pro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 object storage (required; see docs/r2-storage.md). Dev uses bucket `local` with a token scoped to
# `local` only; production uses `main`. DEBUG=true refuses R2_BUCKET=main.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=local

# Qdrant
QDRANT_URL=http://qdrant:6333

# Product image search (master switch; each tenant is also granted in admin)
IMAGE_SEARCH_ENABLED=false
IMAGE_SEARCH_MIN_SCORE=0.80

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
FB_VERIFY_TOKEN=verify-token
# Public https base URL Meta calls (ngrok in dev, domain in prod); shown as the webhook callback URL
PUBLIC_BASE_URL=

# Credit top-ups: Telegram alert for new requests, bKash number customers pay to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BKASH_NUMBER=

# Google / Gemini
GOOGLE_API_KEY=
# Thinking for customer replies (Gemini 3+): low / medium / high; empty = model default
LLM_THINKING_LEVEL=

# Seconds between a reply and the contact-memory LLM extraction that covers it (one run per burst)
MEMORY_UPDATE_DELAY_SECONDS=300

# Parallel customer replies (celery-replies processes)
REPLY_WORKER_CONCURRENCY=16




# Website widget rate limits (DRF rate strings); defaults in core/settings.py
# WIDGET_SESSION_RATE=60/hour
# WIDGET_VISITOR_MESSAGE_RATE=10/min
# WIDGET_MESSAGE_RATE=2000/day
